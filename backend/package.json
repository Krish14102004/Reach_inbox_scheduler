{
  "//": [
    "FILE: backend/package.json",
    "PHASE: 0 - Project Setup & Infrastructure",
    "PURPOSE: Backend dependencies and scripts: dev (API), dev:worker, build, start, start:worker, prisma:*, test, lint."
  ],
  "name": "@reachinbox/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import=tsx --watch src/server.ts",
    "dev:worker": "node --env-file-if-exists=.env --import=tsx --watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "senders:create": "node --env-file-if-exists=.env --import=tsx scripts/create-ethereal-senders.ts",
    "search:reindex": "node --env-file-if-exists=.env --import=tsx scripts/reindex-elasticsearch.ts",
    "load:test": "node --env-file-if-exists=.env --import=tsx scripts/load-test.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.2",
    "@bull-board/express": "^9.10.2",
    "@prisma/client": "^6.16.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
