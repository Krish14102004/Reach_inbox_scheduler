# FILE: backend/.env.example
# PHASE: 0 - Project Setup & Infrastructure
# PURPOSE: Documented template of ALL backend env vars: DB, Redis, ES, JWT/cookie, Google OAuth, Slack OAuth, WORKER_CONCURRENCY, MIN_DELAY_BETWEEN_EMAILS_MS, MAX_EMAILS_PER_HOUR_PER_SENDER, etc.

# App runtime
NODE_ENV=development
PORT=4001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="mysql://root:root@localhost:3307/reachinbox"

# Redis
REDIS_URL=redis://localhost:6379

# Search
ELASTICSEARCH_URL=http://localhost:9200

# Auth / cookies
JWT_SECRET=replace-with-a-32-plus-character-secret
COOKIE_DOMAIN=localhost

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/api/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4001/api/slack/callback

# Ethereal SMTP: set true only for local TLS inspection/self-signed chain issues.
# Certificate verification is always enforced outside development.
ETHEREAL_ALLOW_SELF_SIGNED_CERTS=false

# Worker tuning
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_ATTEMPTS=5
PROCESSING_STALE_AFTER_MS=300000
BULL_BOARD_ENABLED=true
