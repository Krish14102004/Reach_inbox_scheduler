# FILE: backend/.env.example
# PHASE: 0 - Project Setup & Infrastructure
# PURPOSE: Documented template of ALL backend env vars: DB, Redis, ES, JWT/cookie, Google OAuth, Slack OAuth, WORKER_CONCURRENCY, MIN_DELAY_BETWEEN_EMAILS_MS, MAX_EMAILS_PER_HOUR_PER_SENDER, etc.

# App runtime
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="mysql://root:root@localhost:3306/reachinbox"

# Redis
REDIS_URL=redis://localhost:6379

# Search
ELASTICSEARCH_URL=http://localhost:9200

# Auth / cookies
JWT_SECRET=replace-with-a-32-plus-character-secret
COOKIE_DOMAIN=localhost

# Google OAuth (TODO: Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Slack OAuth (TODO: Phase 5)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Worker tuning
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_ATTEMPTS=5
BULL_BOARD_ENABLED=true
